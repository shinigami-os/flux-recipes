[meta]
name = kira-sleex
version = 1.37.12
description = "AxOS Sleex desktop environment (Hyprland + quickshell shell)"
license = GPL-3.0-only
size = 20

[source]
url = git+https://github.com/AxOS-project/Sleex#main
sha256 = 43e817951cf357cfd56d2acad914eaafda6e279b

[deps]
build = icu-data-full gcc g++ libc-dev cmake ninja pkgconf qt6-qtbase-dev qt6-qtdeclarative-dev qt6-qtconnectivity-dev qt6-qt5compat-dev qt6-qtmultimedia-dev networkmanager-dev kira-sleex-ui-kit kira-quickshell rsync
runtime = kira-hyprland kira-quickshell qt6-qtbase qt6-qtbase-sqlite qt6-qtdeclarative qt6-qtwayland qt6-qtconnectivity qt6-qt5compat qt6-qtmultimedia qt6-qtsvg kira-sleex-ui-kit jq sqlite python3 bc networkmanager
optional = matugen hyprlock hypridle wl-clipboard fuzzel foot howdy ffmpeg imagemagick kdialog

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build
# password_face.conf points at /lib/security/pam_howdy.so, which doesn't exist -
# howdy only ships the pam-python bridge. Point it at the real module + script.
sed -i 's#/lib/security/pam_howdy.so#/usr/lib/security/pam_python.so /usr/lib/security/howdy/pam.py#' \
    src/share/sleex/modules/lockscreen/pam/password_face.conf

# upstream sleex.desktop has Exec=sleex (raw binary, no env setup). regreet reads
# this file directly, so login never invoked kira-start-sleex, the wrapper that
# sets XDG_DATA_DIRS/DBUS_SESSION_BUS_ADDRESS - point the entry at it instead.
sed -i 's#^Exec=sleex$#Exec=/usr/bin/kira-start-sleex#' \
    src/share/wayland-sessions/sleex.desktop

# upstream throws Hyprland's own stdout/stderr away, so a crash here just
# looks like a silent bounce back to the greeter with no way to tell why
sed -i 's#start-hyprland -- --config /etc/sleex/hyprland.lua > /dev/null 2>&1#start-hyprland -- --config /etc/sleex/hyprland.lua#' \
    src/bin/sleex

# quickshell's threaded QSG render loop segfaults in libgallium on Intel iGPUs
# (crashes in its dedicated render thread right on Hyprland's own startup
# event, well before anything is on screen - the main thread gets as far as
# activating D-Bus portals fine). Forcing the single-threaded loop avoids the
# GL-context-across-threads class of bug entirely.
sed -i 's#QT_QPA_PLATFORM=wayland qs -p /usr/share/sleex#QT_QPA_PLATFORM=wayland QSG_RENDER_LOOP=basic qs -p /usr/share/sleex#' \
    src/etc/sleex/hyprland/execs.lua

# upstream bug (genuinely present at this commit, not something our pipeline
# broke): the first Loader block in HomeGithubWidget.qml is missing its
# sourceComponent and closing brace, so the parser folds it straight into
# the second Loader - a hard QML parse error that keeps the whole shell from
# loading at all, not just this one widget
# flux's kotodama parser left-trims every line inside a hook body and drops
# blank lines outright, so this can't be a literal indentation/blank-line
# sensitive string - match structurally with a whitespace-tolerant regex
# instead and let QML's brace-delimited grammar not care about indentation
python3 -c "
import re
path = 'src/share/sleex/modules/dashboard/home/HomeGithubWidget.qml'
data = open(path).read()
pattern = re.compile(r'Loader \{\s*asynchronous: true\s*active: root\.connected\s*anchors\.horizontalCenter: parent\.horizontalCenter\s*\n\s*Loader \{')
fixed = 'Loader {\nasynchronous: true\nactive: root.connected\nanchors.horizontalCenter: parent.horizontalCenter\nsourceComponent: GhCalendar {}\n}\n\nLoader {'
new_data, n = pattern.subn(fixed, data)
assert n == 1, 'expected exactly one match, got ' + str(n)
open(path, 'w').write(new_data)
"

# every other apps.* default is a .desktop filename resolved through normal
# desktop-entry lookup, but apps.terminal is the one exception - the three
# call sites that read it (BackgroundContextMenu.qml, DesktopIconContextMenu.qml,
# SearchWidget.qml) all pass it straight to Quickshell.execDetached() as a raw
# argv[0] (plus a --working-directory flag only a real terminal binary
# understands), so the upstream default of "foot.desktop" is guaranteed ENOENT -
# it needs to be the actual binary name
sed -i 's/property string terminal: "foot\.desktop"/property string terminal: "foot"/' \
    src/share/sleex/modules/common/Config.qml

%build
cd src/share/sleex
cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DDISTRIBUTOR="Kira Linux" \
    -DINSTALL_QMLDIR=usr/lib/qt6/qml
cmake --build build

%post-build

%install
install -dm755 "$DESTDIR/usr/bin"
cp -a src/bin/. "$DESTDIR/usr/bin/"
chmod 755 "$DESTDIR/usr/bin/"*
install -dm755 "$DESTDIR/etc"
cp -a src/etc/. "$DESTDIR/etc/"
# CMakeLists sets prefix "/" for the compiled quickshell plugin
( cd src/share/sleex && DESTDIR="$DESTDIR" cmake --install build )
install -dm755 "$DESTDIR/usr/share/sleex"
rsync -a \
    --exclude 'build/' \
    --exclude 'CMakeLists.txt' \
    --exclude 'plugins/' \
    --exclude '.qmlls.ini' \
    --exclude '.qt/' \
    src/share/sleex/ "$DESTDIR/usr/share/sleex/"
install -Dm644 src/share/wayland-sessions/sleex.desktop \
    "$DESTDIR/usr/share/wayland-sessions/sleex.desktop"
