[meta]
name = kira-desktop-sleex
version = 1.0.6
description = "Sleex desktop environment meta-package (Hyprland + quickshell)"
license = MIT
size = 1

[source]

[deps]
build =
runtime = mesa kira-libglvnd xwayland hyprland kira-xdg-desktop-portal-hyprland xdg-desktop-portal-gtk kira-quickshell qt6-qtbase qt6-qtdeclarative qt6-qtwayland qt6-qtsvg kira-matugen kira-hyprlock kira-hypridle wlogout wl-clipboard fuzzel foot pcmanfm-qt grim slurp playerctl brightnessctl pamixer pavucontrol pipewire wireplumber iw kira-nm-connection-editor python3 jq greetd xdg-user-dirs kira-bibata-cursor-theme kira-featherpad flatpak dbus upower networkmanager bluez kira-desktop-fonts kira-sleex kira-desktop-sleex-config

[build]
cflags =

%pre-build

%build

%post-build

%install
install -dm755 "$DESTDIR/usr/share/kira-desktop"
cat > "$DESTDIR/usr/share/kira-desktop/sleex.desktop-env" << 'EOF'
name = sleex
package = kira-desktop-sleex
launch = /usr/bin/kira-start-sleex
description = Sleex desktop: Hyprland compositor with a quickshell bar and Material You theming
EOF
install -Dm755 "$FLUX_RECIPE_DIR/files/kira-start-sleex" "$DESTDIR/usr/bin/kira-start-sleex"

# Sleex hardcodes this wallpaper path; ship Kira's default there so matugen themes from it
install -Dm644 "$FLUX_RECIPE_DIR/files/default.png" "$DESTDIR/usr/share/backgrounds/sleex/SleexOne.png"

%post-install
echo "[kira-desktop-sleex] Sleex installed. Set it active with:"
echo "  echo sleex > ~/.config/kira-desktop/active-de"
