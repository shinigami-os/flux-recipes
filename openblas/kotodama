[meta]
name = openblas
version = 0.3.34
description = "Optimized BLAS/LAPACK library, needed by numpy and dlib (howdy face-auth chain)"
license = BSD-3-Clause
size = 40

[source]
url = https://github.com/OpenMathLib/OpenBLAS/archive/refs/tags/v0.3.34.tar.gz
sha256 = cd7e129868320cc2d033afa920e31202dfe0b8066a5b66661900ccc0f197dfed

[deps]
# Alpine's own openblas also lists linux-headers as a build dep (musl,
# unlike glibc, doesn't bundle full kernel uapi headers) - Kira has no
# such package yet since nothing else has needed it; if this build fails
# on a missing <linux/...> header, that gap is why
build = gcc make perl
runtime =

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
# NO_AFFINITY: Alpine notes this doesn't work reliably on musl
# USE_OPENMP=0: avoids a known miscompile class (GCC bug 60035), matches
# every other musl distro's OpenBLAS build
# DYNAMIC_ARCH=1 + TARGET=CORE2: runtime CPU dispatch with a safe baseline,
# since this needs to run on whatever x86_64 hardware Kira ends up on,
# not just the machine it was built on
FLAGS="MAJOR_VERSION=3 NO_AFFINITY=1 NO_STATIC=1 USE_OPENMP=0 DYNAMIC_ARCH=1 TARGET=CORE2 PREFIX=/usr"
# the main build already produces one combined library with BLAS, CBLAS,
# LAPACK and LAPACKE all in it (confirmed: "OpenBLAS build complete. (BLAS
# CBLAS LAPACK LAPACKE)") - Alpine additionally builds interface/
# shared-blas-lapack for standalone liblapack.so/liblapacke.so aliases, but
# that make target doesn't exist in this version's interface/Makefile, and
# nothing needs it since -lopenblas alone already exports those symbols
make $FLAGS CFLAGS="-O2 -pipe -march=x86-64-v2"

%post-build

%install
FLAGS="MAJOR_VERSION=3 NO_AFFINITY=1 NO_STATIC=1 USE_OPENMP=0 DYNAMIC_ARCH=1 TARGET=CORE2 PREFIX=/usr"
make $FLAGS DESTDIR="$DESTDIR" install
