[meta]
name = kira-kokuin-cli
version =
description = "kokuin-cli: shows how a machine boots, from the firmware to the desktop, and records boots to explain every step"
license = GPL-2.0-only
size = 6

[source]
# rolling: floats on main's latest commit, flux records the built one
url = git+https://github.com/shinigami-os/kokuin-cli#main
sha256 =

[deps]
build = gcc libc-dev pkgconf rust cargo lld
runtime = polkit-elogind

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build
# the EFI probe is built for x86_64-unknown-uefi, a target Alpine's rust ships no standard library for: its std sources
# (the same release as the compiler, checked against rust-lang.org's own checksum) are fetched and built with build-std
v=$(rustc --version | cut -d' ' -f2)
probe=
if curl -fsSL -o rust-src.tar.xz "https://static.rust-lang.org/dist/rust-src-$v.tar.xz" \
    && sum=$(curl -fsSL "https://static.rust-lang.org/dist/rust-src-$v.tar.xz.sha256" | cut -d' ' -f1) \
    && echo "$sum  rust-src.tar.xz" | sha256sum -c - >/dev/null \
    && tar -xf rust-src.tar.xz; then
    probe=1
fi
echo "$probe" > .probe-ok

%build
cargo build --release --locked -p kokuin-cli -p kokuin-init
if [ -n "$(cat .probe-ok)" ]; then
    RUSTC_BOOTSTRAP=1 __CARGO_TESTS_ONLY_SRC_ROOT="$PWD/rust-src-$(rustc --version | cut -d' ' -f2)/rust-src/lib/rustlib/src/rust/library" \
        cargo build --release -Zbuild-std=core,alloc,compiler_builtins -Zbuild-std-features=compiler-builtins-mem \
        --locked --target x86_64-unknown-uefi -p kokuin-probe || echo > .probe-ok
fi

%post-build

%install
install -Dm755 target/release/kokuin-cli "$DESTDIR/usr/bin/kokuin-cli"
install -Dm755 target/release/kokuin-init "$DESTDIR/usr/lib/kokuin/kokuin-init"
if [ -n "$(cat .probe-ok)" ]; then
    install -Dm644 target/x86_64-unknown-uefi/release/kokuin-probe.efi "$DESTDIR/usr/lib/kokuin/kokuin-probe.efi"
fi
install -Dm644 LICENSE "$DESTDIR/usr/share/licenses/kira-kokuin-cli/LICENSE"

%post-install
