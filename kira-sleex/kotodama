[meta]
name = kira-sleex
version = 1.37
description = "AxOS Sleex desktop environment (Hyprland + quickshell shell)"
license = GPL-3.0-only
size = 20

[source]
url = git+https://github.com/AxOS-project/Sleex#main
sha256 = 6892ef4865abe3a86e24a03a92b35f124daa5aed

[deps]
build = gcc cmake ninja pkgconf qt6-base qt6-declarative qt6-connectivity qt6-5compat qt6-multimedia kira-sleex-ui-kit kira-quickshell rsync
runtime = hyprland kira-quickshell qt6-base qt6-declarative qt6-wayland qt6-connectivity qt6-5compat qt6-multimedia qt6-svg kira-sleex-ui-kit jq sqlite python3 bc
optional = matugen hyprlock hypridle wl-clipboard fuzzel foot howdy ffmpeg imagemagick kdialog

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build
# password_face.conf points at /lib/security/pam_howdy.so, which doesn't exist -
# howdy only ships the pam-python bridge. Point it at the real module + script.
sed -i 's#/lib/security/pam_howdy.so#/usr/lib/security/pam_python.so /usr/lib/security/howdy/pam.py#' \
    src/share/sleex/modules/lockscreen/pam/password_face.conf

# upstream sleex.desktop has Exec=sleex (raw binary, no env setup). regreet reads
# this file directly, so login never invoked kira-start-sleex, the wrapper that
# sets XDG_DATA_DIRS/DBUS_SESSION_BUS_ADDRESS - point the entry at it instead.
sed -i 's#^Exec=sleex$#Exec=/usr/bin/kira-start-sleex#' \
    src/share/wayland-sessions/sleex.desktop

# upstream throws Hyprland's own stdout/stderr away, so a crash here just
# looks like a silent bounce back to the greeter with no way to tell why
sed -i 's#start-hyprland -- --config /etc/sleex/hyprland.lua > /dev/null 2>&1#start-hyprland -- --config /etc/sleex/hyprland.lua#' \
    src/bin/sleex

# quickshell's threaded QSG render loop segfaults in libgallium on Intel iGPUs
# (crashes in its dedicated render thread right on Hyprland's own startup
# event, well before anything is on screen - the main thread gets as far as
# activating D-Bus portals fine). Forcing the single-threaded loop avoids the
# GL-context-across-threads class of bug entirely.
sed -i 's#QT_QPA_PLATFORM=wayland qs -p /usr/share/sleex#QT_QPA_PLATFORM=wayland QSG_RENDER_LOOP=basic qs -p /usr/share/sleex#' \
    src/etc/sleex/hyprland/execs.lua

%build
cd src/share/sleex
cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DDISTRIBUTOR="Kira Linux" \
    -DINSTALL_QMLDIR=usr/qml
cmake --build build

%post-build

%install
install -dm755 "$DESTDIR/usr/bin"
cp -a src/bin/. "$DESTDIR/usr/bin/"
chmod 755 "$DESTDIR/usr/bin/"*
install -dm755 "$DESTDIR/etc"
cp -a src/etc/. "$DESTDIR/etc/"
# CMakeLists sets prefix "/" for the compiled quickshell plugin
( cd src/share/sleex && DESTDIR="$DESTDIR" cmake --install build )
install -dm755 "$DESTDIR/usr/share/sleex"
rsync -a \
    --exclude 'build/' \
    --exclude 'CMakeLists.txt' \
    --exclude 'plugins/' \
    --exclude '.qmlls.ini' \
    --exclude '.qt/' \
    src/share/sleex/ "$DESTDIR/usr/share/sleex/"
install -Dm644 src/share/wayland-sessions/sleex.desktop \
    "$DESTDIR/usr/share/wayland-sessions/sleex.desktop"
