[meta]
name = kira-fht-compositor
version = 26.09.0
description = "fht-compositor: a dynamic tiling Wayland compositor built on Smithay, the eventual Hyprland replacement for Sleex"
license = GPL-3.0-only
size = 20

[source]
url = git+https://github.com/nferhat/fht-compositor#main
sha256 = f20a44701430d29acb6153400d80172829c109cf

[deps]
build = gcc g++ libc-dev rust cargo pkgconf clang20-libclang wayland-dev libxkbcommon-dev mesa-dev libinput-dev libseat-dev libdrm-dev libdisplay-info-dev eudev-dev git
# fht-compositor has no XWayland support at all (confirmed against its own source) -
# Wayland-native clients only, unlike Hyprland
runtime = wayland libxkbcommon mesa mesa-egl mesa-gl mesa-gles mesa-dri-gallium libinput libseat libdrm libdisplay-info eudev-libs dbus mesa-vulkan-intel mesa-vulkan-swrast

[build]
cflags =

%pre-build

%build
# bindgen (pulled in by libspa-sys, itself only needed by the xdg-screencast-portal
# feature) reliably segfaults inside libLLVM on this system - there are 3 unrelated
# LLVM versions installed side by side (pulled in transitively by other packages),
# and no combination of LIBCLANG_PATH/a clean target dir avoided it, pointing at a
# deeper bindgen/concurrent-build issue rather than a simple path mismatch. Screencast
# support is dropped for now rather than blocking the compositor itself on it - it
# needs real investigation as a follow-up, not a guess-and-check fix at 2am.
export LIBCLANG_PATH=/usr/lib/llvm20/lib

# matches default.nix's own linker flags exactly - without them the linker's default
# --as-needed drops EGL/wayland-client since nothing references them at link time, but
# the compositor still dlopen()s symbols from both at runtime and segfaults without them
export RUSTFLAGS="-C link-arg=-Wl,--push-state,--no-as-needed -C link-arg=-lEGL -C link-arg=-lwayland-client -C link-arg=-Wl,--pop-state"
# headless-backend is dev/test-only per its own doc comment in Cargo.toml, and the
# systemd feature is meaningless on runit - winit-backend is kept for a quick nested
# debug session, udev-backend is the one that actually matters for real hardware
cargo build --profile opt -p fht-compositor --no-default-features --features winit-backend,udev-backend

%post-build

%install
install -Dm755 target/opt/fht-compositor "$DESTDIR/usr/bin/fht-compositor"

# upstream's own res/systemd/fht-compositor.desktop points Exec at a systemd-only
# session script that hard-refuses to run without systemctl - Kira needs its own,
# same shape as kira-start-sleex wrapping start-hyprland
install -Dm755 "$FLUX_RECIPE_DIR/files/kira-start-fht" "$DESTDIR/usr/bin/kira-start-fht"
install -Dm644 "$FLUX_RECIPE_DIR/files/fht-compositor.desktop" "$DESTDIR/usr/share/wayland-sessions/fht-compositor.desktop"
