[meta]
name = automake
version = 1.18
description = "Tool for generating GNU-style Makefile.in files (GNU Build System)"
license = GPL-2.0-or-later
size = 3

[source]
url = https://ftp.gnu.org/gnu/automake/automake-1.18.tar.xz
sha256 = 5bdccca96b007a7e344c24204b9b9ac12ecd17f5971931a9063bdee4887f4aaf

[deps]
build = gcc make perl autoconf
runtime = perl autoconf

[build]
cflags =

%pre-build

%build
./configure --prefix=/usr
make

%post-build

%install
make DESTDIR="$DESTDIR" install
