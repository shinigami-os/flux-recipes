[meta]
name = kmod
version = 34.2
description = "libkmod, plus a real depmod - busybox's depmod lacks -b (base dir) needed by kernel builds"
license = LGPL-2.1-or-later
size = 2

[source]
url = https://mirrors.edge.kernel.org/pub/linux/utils/kernel/kmod/kmod-34.2.tar.xz
sha256 = 5a5d5073070cc7e0c7a7a3c6ec2a0e1780850c8b47b3e3892226b93ffcb9cb54

[deps]
build = gcc make pkgconf
runtime =

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
export CFLAGS="-O2 -pipe -march=x86-64-v2"
./configure \
    --host="${FLUX_CROSS_HOST:-}" \
    --prefix=/usr \
    --sysconfdir=/etc \
    --disable-manpages
make

%post-build

%install
# skip install-exec-hook: it uses "ln --force", unsupported by busybox's ln
make DESTDIR="$DESTDIR" install-binPROGRAMS install-libLTLIBRARIES
# only depmod is replaced; modprobe/insmod/rmmod/lsmod stay on busybox
install -dm755 "$DESTDIR/sbin"
ln -sf ../usr/bin/kmod "$DESTDIR/sbin/depmod"
