[meta]
name = attr
version = 2.5.2
description = "Extended attributes library, needed by acl"
license = LGPL-2.1-or-later
size = 2

[source]
# deliberately not the latest (2.6.0): that version added libmisc/xattrat.c,
# using the newer *at-family xattr syscalls (struct xattr_args, Linux
# 6.13+) that musl's headers don't define at all - a real glibc/musl
# divergence, not something to patch around. acl only needs the original
# getxattr/setxattr/listxattr functions, which 2.5.2 already has, so this
# sidesteps the incompatibility entirely instead of fighting it.
# upstream (savannah.gnu.org) was returning 502s at packaging time - same
# tarball, repackaged by Debian, verified against its own sha256
url = http://deb.debian.org/debian/pool/main/a/attr/attr_2.5.2.orig.tar.xz
sha256 = f2e97b0ab7ce293681ab701915766190d607a1dba7fae8a718138150b700a70b

[deps]
build = gcc make
runtime =

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build
# basename() needs <libgen.h> - musl doesn't pull it in transitively via
# other headers the way glibc often does, so this is missing entirely
grep -q '#include <libgen.h>' tools/attr.c || sed -i '1i #include <libgen.h>' tools/attr.c

%build
export CFLAGS="-O2 -pipe -march=x86-64-v2"
./configure --prefix=/usr
make

%post-build

%install
make DESTDIR="$DESTDIR" install
