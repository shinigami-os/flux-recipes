#!/bin/sh
i=0
while [ ! -S /var/run/dbus/system_bus_socket ] && [ $i -lt 15 ]; do
    sleep 1
    i=$((i + 1))
done

# the wifi interface is wlan0 until eudev-trigger renames it, and NM caches the old name if it enumerates first
i=0
while [ ! -e /etc/sv/eudev-trigger/down ] && [ $i -lt 40 ]; do
    sleep 1
    i=$((i + 1))
done

exec /usr/sbin/NetworkManager --no-daemon
