[meta]
name = kira-materialyoucolor
version = 3.0.4
description = "Material You color generation (python bindings with the native celebi quantizer), used by Sleex's palette script - Alpine has no package for it"
license = MIT
size = 2

[source]
url = https://files.pythonhosted.org/packages/eb/23/2e63e7bdfcc1aa7ba955386ad09e3bd8a535a1092d7af501659b63cb6282/materialyoucolor-3.0.4.tar.gz
sha256 = 30b8dde034dce180845b0eaf52f72c5b22cd5b60bd7aff96804febae4e266276

[deps]
build = gcc g++ libc-dev python3-dev py3-setuptools py3-pybind11
runtime = python3 py3-pillow

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
export CFLAGS="-O2 -pipe -march=x86-64-v2"
export CXXFLAGS="-O2 -pipe -march=x86-64-v2"
# the celebi quantizer is a pybind11 C++ extension, so setup.py has to compile it
python3 setup.py build

%post-build

%install
# setup.py install is deprecated in current setuptools, so copy the built tree
# instead - build/lib.* already holds the package plus its compiled celebi module
site=$(python3 -c 'import sysconfig; print(sysconfig.get_path("platlib"))')
install -dm755 "$DESTDIR$site"
for d in build/lib*; do
    cp -a "$d/." "$DESTDIR$site/"
done
