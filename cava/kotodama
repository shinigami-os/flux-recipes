[meta]
name = cava
version = 1.0.0
description = "Console audio visualizer for ALSA/PulseAudio/PipeWire"
license = MIT
size = 3

[source]
url = git+https://github.com/karlstav/cava#1.0.0
sha256 = 15f89867908fa66baaaec8d4b9a2d684a329a0fb

[deps]
build = gcc make autoconf automake libtool pkgconf fftw iniparser ncurses pipewire
runtime = fftw iniparser ncurses pipewire

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build
NOCONFIGURE=1 ./autogen.sh

%build
export CFLAGS="-O2 -pipe -march=x86-64-v2"
./configure --prefix=/usr \
    --disable-input-alsa \
    --disable-input-pulse \
    --disable-input-sndio \
    --disable-input-fifo
make

%post-build

%install
make DESTDIR="$DESTDIR" install
