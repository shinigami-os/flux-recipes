[meta]
name = nvidia-utils
version = 610.57.04
description = "NVIDIA userspace driver: EGL/GLX/GLES libraries and GBM backend"
license = NVIDIA-driver-EULA
size = 180

[source]
url = https://download.nvidia.com/XFree86/Linux-x86_64/610.57.04/NVIDIA-Linux-x86_64-610.57.04.run
sha256 = b2e935c66b83bb00c0c857bc8e0ee0fd52de9286b40c9cc1eec29a7ce7eb116d

[deps]
build =
runtime = nvidia-open

[build]
cflags =

%pre-build
sh NVIDIA-Linux-x86_64-610.57.04.run --extract-only

%build

%post-build

%install
D="NVIDIA-Linux-x86_64-610.57.04"
install -dm755 "$DESTDIR/usr/lib" "$DESTDIR/usr/lib/gbm"
install -dm755 "$DESTDIR/usr/share/glvnd/egl_vendor.d" "$DESTDIR/usr/share/egl/egl_external_platform.d"
for f in libnvidia-glcore.so.610.57.04 libnvidia-tls.so.610.57.04 libGLX_nvidia.so.610.57.04 \
         libnvidia-glsi.so.610.57.04 libnvidia-eglcore.so.610.57.04 libEGL_nvidia.so.610.57.04 \
         libGLESv2_nvidia.so.610.57.04 libGLESv1_CM_nvidia.so.610.57.04 libnvidia-cfg.so.610.57.04 \
         libnvidia-allocator.so.610.57.04 libnvidia-egl-wayland.so.1.1.20 \
         libnvidia-egl-wayland2.so.1.0.1 libnvidia-egl-gbm.so.1.1.3; do
    install -m755 "$D/$f" "$DESTDIR/usr/lib/$f"
done
ln -sf libGLX_nvidia.so.610.57.04 "$DESTDIR/usr/lib/libGLX_nvidia.so.0"
ln -sf libEGL_nvidia.so.610.57.04 "$DESTDIR/usr/lib/libEGL_nvidia.so.0"
ln -sf libGLESv2_nvidia.so.610.57.04 "$DESTDIR/usr/lib/libGLESv2_nvidia.so.2"
ln -sf libGLESv1_CM_nvidia.so.610.57.04 "$DESTDIR/usr/lib/libGLESv1_CM_nvidia.so.1"
ln -sf libnvidia-cfg.so.610.57.04 "$DESTDIR/usr/lib/libnvidia-cfg.so.1"
ln -sf libnvidia-cfg.so.1 "$DESTDIR/usr/lib/libnvidia-cfg.so"
ln -sf libnvidia-allocator.so.610.57.04 "$DESTDIR/usr/lib/libnvidia-allocator.so.1"
ln -sf libnvidia-allocator.so.1 "$DESTDIR/usr/lib/libnvidia-allocator.so"
ln -sf libnvidia-egl-wayland.so.1.1.20 "$DESTDIR/usr/lib/libnvidia-egl-wayland.so.1"
ln -sf libnvidia-egl-wayland2.so.1.0.1 "$DESTDIR/usr/lib/libnvidia-egl-wayland2.so.1"
ln -sf libnvidia-egl-gbm.so.1.1.3 "$DESTDIR/usr/lib/libnvidia-egl-gbm.so.1"
ln -sf ../libnvidia-allocator.so.1 "$DESTDIR/usr/lib/gbm/nvidia-drm_gbm.so"
install -m644 "$D/10_nvidia.json" "$DESTDIR/usr/share/glvnd/egl_vendor.d/10_nvidia.json"
install -m644 "$D/10_nvidia_wayland.json" "$DESTDIR/usr/share/egl/egl_external_platform.d/10_nvidia_wayland.json"
install -m644 "$D/09_nvidia_wayland2.json" "$DESTDIR/usr/share/egl/egl_external_platform.d/09_nvidia_wayland2.json"
install -m644 "$D/15_nvidia_gbm.json" "$DESTDIR/usr/share/egl/egl_external_platform.d/15_nvidia_gbm.json"
install -dm755 "$DESTDIR/usr/share/licenses/nvidia-utils"
install -m644 "$D/LICENSE" "$DESTDIR/usr/share/licenses/nvidia-utils/"

%post-install
echo "[nvidia-utils] EGL/GLX/GBM userspace driver installed, version-locked to nvidia-open 610.57.04."
echo "[nvidia-utils] musl has no ldconfig cache - every SONAME needed an explicit symlink here, unlike NVIDIA's own installer which relies on it."
