[meta]
name = python2
version = 2.7.18
description = "Python 2 (EOL) - only kept for pam-python/howdy's PAM glue script, nothing else should depend on this"
license = PSF-2.0
size = 15

[source]
url = https://www.python.org/ftp/python/2.7.18/Python-2.7.18.tar.xz
sha256 = b62c0e7937551d0cc02b8fd5cb0f544f9405bafc9a54d3808ed4594812edef43

[deps]
build = gcc make zlib
runtime = zlib

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
# GCC 14 makes implicit-function-declaration a hard error by default; Python
# 2.7's ancient build trips this in several places. Deliberately not linking
# openssl: 2.7's _ssl module targets OpenSSL 1.0/1.1 APIs that 3.x removed, and
# this build only exists for howdy's stdlib-only PAM glue script (no networking).
export CFLAGS="-O2 -pipe -march=x86-64-v2 -Wno-error=implicit-function-declaration"
./configure \
  --prefix=/usr \
  --enable-shared \
  --without-ensurepip
make

%post-build

%install
make DESTDIR=$DESTDIR install
