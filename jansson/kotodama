[meta]
name = jansson
version = 2.15.1.2
description = "C library for encoding, decoding, and manipulating JSON"
license = MIT
size = 2

[source]
url = git+https://github.com/akheron/jansson#v2.15.1
sha256 = dbb5fb3636e155fccfce4cd215de752779bd6971

[deps]
build = gcc cmake ninja
runtime =

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DJANSSON_BUILD_DOCS=OFF \
    -DJANSSON_EXAMPLES=OFF \
    -DJANSSON_BUILD_SHARED_LIBS=ON
cmake --build build

%post-build

%install
DESTDIR="$DESTDIR" cmake --install build
