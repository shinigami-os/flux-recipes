[meta]
name = libusb
version = 1.0.30
description = "Library for USB device access"
license = LGPL-2.1-or-later
size = 3

[source]
url = https://github.com/libusb/libusb/releases/download/v1.0.30/libusb-1.0.30.tar.bz2
sha256 = fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf

[deps]
build = gcc make eudev
runtime = eudev

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
export CFLAGS="-O2 -pipe -march=x86-64-v2"
./configure --prefix=/usr
make

%post-build

%install
make DESTDIR="$DESTDIR" install
