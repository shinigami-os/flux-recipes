[meta]
name = kira-eww
version = 0.6.0.4
description = "ElKowars wacky widgets - status bar and widgets in Scheme"
license = MIT
size = 20

[source]
url = https://github.com/elkowar/eww/archive/refs/tags/v0.6.0.tar.gz
sha256 = cef361946946c566b79f8ddc6208d1a3f16b4ff9961439a3f86935e1cfa174a1

[deps]
build = pkgconf gtk+3.0-dev gdk-pixbuf-dev pango-dev libdbusmenu-gtk3-dev gtk-layer-shell-dev rust cargo
runtime = gtk+3.0 gdk-pixbuf pango libdbusmenu-gtk3 gtk-layer-shell

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build
mkdir -p .cargo
if [ -n "$FLUX_CROSS_HOST" ]; then
perl -e '
print "[target.x86_64-unknown-linux-musl]\n";
print "linker = \"x86_64-linux-musl-gcc\"\n";
' > .cargo/config.toml
fi
# eww always calls gtk_layer_shell::init_for_window() unconditionally on wayland,
# with no yuck-level opt-out - fine under sway/Hyprland, but cage (Kira Login's
# greeter compositor) has no wlr-layer-shell at all, and gtk-layer-shell's own
# fallback silently no-ops every anchor/margin/exclusive-zone call and never
# gives the window a real size, so wlroots rejects it as an invalid 0x0 surface.
# Skip layer-shell entirely when unsupported instead.
patch -p1 < "$FLUX_RECIPE_DIR/files/skip-layer-shell-if-unsupported.patch"

%build
# eww's own Cargo.lock pins time 0.3.34, which fails to compile under Alpine's
# current rustc (a stricter Box<_> inference check landed after that release) -
# bump just that crate within its semver range instead of the whole lock file
cargo update -p time@0.3.34
if [ -n "$FLUX_CROSS_HOST" ]; then
    export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=x86_64-linux-musl-gcc
    export PKG_CONFIG_SYSROOT_DIR="${FLUX_CROSS_SYSROOT}"
    export RUSTFLAGS="-C target-feature=-crt-static"
    cargo build --release --locked --no-default-features --features=wayland --target x86_64-unknown-linux-musl
else
    cargo build --release --locked --no-default-features --features=wayland
fi

%post-build

%install
if [ -n "$FLUX_CROSS_HOST" ]; then
    install -Dm755 target/x86_64-unknown-linux-musl/release/eww "$DESTDIR/usr/bin/eww"
else
    install -Dm755 target/release/eww "$DESTDIR/usr/bin/eww"
fi
