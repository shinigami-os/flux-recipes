[meta]
name = kira-quickshell
version = 0.3.0.1
description = "Flexible QtQuick-based desktop shell toolkit"
license = LGPL-3.0-only
size = 15

[source]
url = git+https://github.com/quickshell-mirror/quickshell#v0.3.0
sha256 =

[deps]
build = gcc cmake ninja pkgconf qt6-qtbase-dev qt6-qtdeclarative-dev qt6-qtwayland-dev kira-cli11 vulkan-headers wayland wayland-protocols pipewire libdrm mesa
runtime = qt6-qtbase qt6-qtdeclarative qt6-qtwayland wayland pipewire libdrm mesa

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
cmake -S . -B build -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DDISTRIBUTOR="Kira Linux" \
    -DUSE_JEMALLOC=OFF \
    -DCRASH_HANDLER=OFF \
    -DX11=OFF \
    -DBUILD_TESTING=OFF
cmake --build build

%post-build

%install
DESTDIR="$DESTDIR" cmake --install build
