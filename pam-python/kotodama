[meta]
name = pam-python
version = 1.0.7
description = "Embeds a Python interpreter into PAM so modules can be written in Python - only needed for howdy's PAM glue"
license = AGPL-3.0-or-later
size = 2

[source]
url = https://downloads.sourceforge.net/project/pam-python/pam-python-1.0.7-1/pam-python-1.0.7.tar.gz
sha256 = 96ce72fe355b03b87c0eb540ecef06f33738f98f56581e81eb5bffbad1a47e07

[deps]
build = gcc make python2 linux-pam
runtime = python2 linux-pam

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
# built directly via setup.py rather than the bundled Makefile, which
# hardcodes -Werror alongside -Wall -Wextra -Wshadow etc - this 15-year-old
# C file trips several of those under any remotely modern compiler, and
# none of that is worth fighting for a module only used to run one tiny
# glue script
cd src
export CFLAGS="-O2 -pipe -march=x86-64-v2"
python2 setup.py build

%post-build

%install
cd src
install -dm755 "$DESTDIR/usr/lib/security"
so=$(find build -name 'pam_python.so')
install -m755 "$so" "$DESTDIR/usr/lib/security/pam_python.so"
