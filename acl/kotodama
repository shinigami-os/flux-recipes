[meta]
name = acl
version = 2.3.2
description = "POSIX Access Control Lists library and utilities"
license = LGPL-2.1-or-later
size = 3

[source]
# deliberately not the latest (2.4.0): like attr 2.6.0, it added
# libmisc/xattrat.c using the newer *at-family xattr syscalls
# (struct xattr_args, Linux 6.13+) that musl's headers don't define at
# all - same real glibc/musl divergence, same reason for pinning older.
# upstream (savannah.gnu.org) was returning 502s at packaging time - same
# tarball, repackaged by Debian, verified against its own sha256
url = http://deb.debian.org/debian/pool/main/a/acl/acl_2.3.2.orig.tar.xz
sha256 = 97203a72cae99ab89a067fe2210c1cbf052bc492b479eca7d226d9830883b0bd

[deps]
# needs attr/error_context.h at configure time, not just discoverable from
# reading configure.ac's own autoconf macros
build = gcc make attr
runtime = attr

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
export CFLAGS="-O2 -pipe -march=x86-64-v2"
./configure --prefix=/usr
make

%post-build

%install
make DESTDIR="$DESTDIR" install
