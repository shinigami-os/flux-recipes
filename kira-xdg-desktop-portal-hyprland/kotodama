[meta]
name = kira-xdg-desktop-portal-hyprland
version = 1.3.12.5
description = "xdg-desktop-portal backend for Hyprland"
license = BSD-3-Clause
size = 4

[source]
url = git+https://github.com/hyprwm/xdg-desktop-portal-hyprland#v1.3.12
sha256 =

[deps]
build = gcc g++ libc-dev cmake ninja pkgconf hyprwayland-scanner hyprland-protocols hyprlang-dev hyprutils-dev sdbus-cpp-dev qt6-qtbase-dev pipewire-dev wayland-dev wayland-protocols libdrm-dev mesa-dev xdg-desktop-portal-dev
runtime = hyprlang hyprutils sdbus-cpp qt6-qtbase pipewire wayland libdrm mesa xdg-desktop-portal

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build
if [ -n "$FLUX_CROSS_HOST" ]; then
# hyprland-share-picker is a standalone Qt Widgets GUI the portal launches as a subprocess at
# runtime, not linked into the portal daemon itself - cross-building it needs the host and target
# Qt6 versions to match exactly for moc/uic, which they don't here (6.8.2 host vs 6.8.3 target)
sed -i '/add_subdirectory(hyprland-share-picker)/d;/install(TARGETS hyprland-share-picker)/d' CMakeLists.txt
cat > toolchain.cmake << EOF
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER ${CC:-x86_64-linux-musl-gcc g++})
set(CMAKE_CXX_COMPILER ${CXX:-x86_64-linux-musl-g++})
set(CMAKE_SYSROOT ${FLUX_CROSS_SYSROOT})
set(CMAKE_FIND_ROOT_PATH ${FLUX_CROSS_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
EOF
fi

%build
# Qt's own moc/uic/rcc have to run on the build host, not the musl target -
# QT_HOST_PATH points the cross Qt6Config at a native Qt6 install to find them
cmake -S . -B build -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_LIBDIR=lib \
    ${FLUX_CROSS_HOST:+-DCMAKE_TOOLCHAIN_FILE=$(pwd)/toolchain.cmake} \
    ${FLUX_CROSS_HOST:+-DQT_HOST_PATH=/usr}
cmake --build build

%post-build

%install
DESTDIR="$DESTDIR" cmake --install build
