[meta]
name = util-linux
version = 2.42.1
description = "Linux utility suite: fdisk, mount, lsblk, blkid, libuuid, libblkid, libmount"
license = GPL-2.0-or-later AND LGPL-2.1-or-later
size = 7

[source]
url = https://www.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-2.42.tar.xz
sha256 = 3452b260bbaa775d6e749ac3bb22111785003fc1f444970025c8da26dfa758e9

[deps]
build = gcc make
runtime =

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build
# bash lives at /usr/bin/bash here, not /bin/bash (no usrmerge) - these two
# generate errnos.h/syscalls.h during the build itself, unlike the rest of
# tools/ and tests/ which are dev-only and never invoked by a plain `make`
sed -i '1s|^#!/bin/bash|#!/usr/bin/bash|' tools/all_errnos tools/all_syscalls

%build
./configure \
    --prefix=/usr \
    --libdir=/usr/lib \
    --bindir=/usr/bin \
    --sbindir=/usr/bin \
    --localstatedir=/var \
    --without-systemd \
    --without-udev \
    --without-python \
    --without-ncurses \
    --disable-nls \
    --disable-makeinstall-chown \
    --disable-makeinstall-setuid \
    ${FLUX_CROSS_HOST:+--host=$FLUX_CROSS_HOST} \
    ${CC:+CC=$CC}
make

%post-build

%install
make DESTDIR="$DESTDIR" install
