[meta]
name = ddcutil
version = 2.2.7
description = "Query and change monitor settings via DDC/CI and USB"
license = GPL-2.0-only
size = 5

[source]
url = git+https://github.com/rockowitz/ddcutil#v2.2.7
sha256 = 4edf054c6bfddcc62174bbc453e26c73cfbe7bbf

[deps]
build = gcc make autoconf automake libtool pkgconf dbus eudev glib i2c-tools jansson kmod libdrm libusb libXrandr acl
runtime = dbus eudev glib i2c-tools jansson kmod libdrm libusb libXrandr acl

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build
# execinfo.h (backtrace()) is glibc-only - the actual backtrace() calls are
# already guarded by #ifdef BACKTRACE (a separate, unset-by-default macro),
# but the #include itself is unconditional and musl has no such header at
# all. Same fix Alpine carries for this exact package.
sed -i 's/#include <execinfo.h>/#ifdef __GLIBC__\n#include <execinfo.h>\n#endif/' src/util/linux_util.c
NOCONFIGURE=1 ./autogen.sh

%build
export CFLAGS="-O2 -pipe -march=x86-64-v2"
./configure --prefix=/usr --mandir=/usr/share/man
make

%post-build

%install
make DESTDIR="$DESTDIR" install
