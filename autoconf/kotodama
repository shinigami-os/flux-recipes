[meta]
name = autoconf
version = 2.73
description = "Tool for producing configure scripts (GNU Build System)"
license = GPL-3.0-or-later
size = 3

[source]
url = https://ftp.gnu.org/gnu/autoconf/autoconf-2.73.tar.xz
sha256 = 9fd672b1c8425fac2fa67fa0477b990987268b90ff36d5f016dae57be0d6b52e

[deps]
build = gcc make perl m4
runtime = perl m4

[build]
cflags =

%pre-build

%build
./configure --prefix=/usr
make

%post-build

%install
make DESTDIR="$DESTDIR" install
