[meta]
name = kira-elogind
version = 252.39.14
description = "systemd's logind extracted to a standalone daemon for non-systemd systems"
license = LGPL-2.1-or-later
size = 3

[source]
url = https://github.com/elogind/elogind/archive/refs/tags/v252.39.tar.gz
sha256 = 5789c9d483dc236fbf72143dc9989329c399b6a507892c160b3c5852913123d5

[deps]
build = gcc g++ libc-dev meson ninja pkgconf glib-dev linux-pam-dev eudev-dev libcap-dev gperf python3 py3-jinja2 polkit-dev bash
runtime = glib linux-pam eudev libcap dbus polkit-elogind

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build
# Kira's own musl toolchain never creates the libc.musl-x86_64.so.1 alias
# next to the real loader (ld-musl-x86_64.so.1) that Alpine's own musl
# package normally ships - ld's default search path finds it fine at
# runtime via the loader itself, but several Alpine-built .so files (e.g.
# libcap.so.2) carry a literal DT_NEEDED on that exact filename, and with
# -Wl,--fatal-warnings (elogind's own linker flags) the "not found" warning
# escalates into a hard link failure. This is a system-wide gap, not
# specific to elogind - if it recurs elsewhere, it belongs in kira-base.
ln -sf ld-musl-x86_64.so.1 /lib/libc.musl-x86_64.so.1

# needed by meson.build for code generation - Alpine's python3 package ships
# with no bundled pip/ensurepip wheels (unlike the pre-migration source
# this recipe came from), so pull the real Alpine py3-jinja2 package instead
# of trying to bootstrap pip
# busybox's realpath has no --relative-to (a GNU coreutils extension); meson.build
# only uses it for a cosmetic path string, so swap the call (lines 35-38 of this
# pinned tarball) for a python3 one-liner instead - kotodama hook bodies strip
# leading whitespace and would mangle indented multi-line python pasted in directly
grep -q "run_command('realpath'," meson.build
sed -i "35,38c relative_source_path = run_command('python3', '-c', 'import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))', project_source_root, project_build_root, check : true).stdout().strip()" meson.build
# musl does not provide transitive includes that glibc does
grep -rl 'sigfillset\|pthread_sigmask\|SIG_BLOCK\|SIG_SETMASK\|sigprocmask\|sigaction\|sigemptyset' src/ | grep '\.c$\|\.h$' | while read f; do
    grep -q '#include <signal.h>' "$f" || sed -i '1s|^|#include <signal.h>\n|' "$f"
done
grep -rl 'struct stat\b' src/libelogind/sd-journal/ | grep '\.h$' | while read f; do
    grep -q '#include <sys/stat.h>' "$f" || sed -i '1s|^|#include <sys/stat.h>\n|' "$f"
done
grep -rl '\bbasename\b\|\bdirname\b' src/ | grep '\.c$\|\.h$' | while read f; do
    grep -q '#include <libgen.h>' "$f" || sed -i '1s|^|#include <libgen.h>\n|' "$f"
done
sed -i 's/(uintmax_t)rl\.rlim_cur/(unsigned long long)rl.rlim_cur/g' src/basic/rlimit-util.c
sed -i '/x25_hdlc_proto/d' src/basic/linux/if.h
# musl has no gshadow.h - provide a stub (glibc-only header)
# trailing semicolon in strerror_r macro breaks expression-context use
sed -i 's/: m);$/: m)/' src/basic/musl_missing.h
cat > src/shared/gshadow.h << 'GSHADOW_EOF'
#pragma once
struct sgrp {
    char *sg_namp;
    char *sg_passwd;
    char **sg_adm;
    char **sg_mem;
};
struct sgrp *getsgnam(const char *);
struct sgrp *getsgent(void);
void setsgent(void);
void endsgent(void);
GSHADOW_EOF
if [ -n "$FLUX_CROSS_HOST" ]; then
cat > cross-file.ini << EOF
[host_machine]
system = 'linux'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
[binaries]
c = '${CC:-gcc}'
ar = '${AR:-ar}'
strip = '${STRIP:-strip}'
pkg-config = 'pkg-config'
[properties]
sys_root = '${FLUX_CROSS_SYSROOT}'
pkg_config_libdir = ['${FLUX_CROSS_SYSROOT}/usr/lib/pkgconfig']
EOF
fi

%build
meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    ${FLUX_CROSS_HOST:+--cross-file=cross-file.ini} \
    -Drootprefix=/usr \
    -Drootlibdir=/usr/lib \
    -Dpkgconfiglibdir=/usr/lib/pkgconfig \
    -Dpamlibdir=/usr/lib/security \
    -Dpamconfdir=/etc/pam.d \
    -Dcgroup-controller=elogind \
    -Ddefault-kill-user-processes=false \
    -Dman=false \
    -Dhtml=false \
    -Dacl=false \
    -Daudit=false \
    -Dsmack=false \
    -Dselinux=false \
    -Defi=false \
    -Dpolkit=true \
    -Dpam=true \
    -Dbashcompletiondir=no \
    -Dzshcompletiondir=no \
    -Dtests=false \
    -Dutmp=false
ninja -C build

%install
DESTDIR="$DESTDIR" ninja -C build install
# nothing in Kira builds against elogind's C API directly - swayFX's own
# build chain pulls Alpine's elogind-dev transitively (via wlroots), which
# conflicts outright with these same paths since both packages try to own
# them. Kira only needs the daemon/loginctl/pam module/libs, so drop the
# headers and let elogind-dev be the one and only header source.
rm -rf "$DESTDIR/usr/include/elogind"
rm -f "$DESTDIR"/usr/include/sd-*.h "$DESTDIR/usr/include/_sd-common.h"
rm -f "$DESTDIR/usr/lib/pkgconfig/libelogind.pc"
install -dm755 "$DESTDIR/etc/sv/elogind"
install -Dm755 "$FLUX_RECIPE_DIR/files/elogind/run" "$DESTDIR/etc/sv/elogind/run"
# without this, elogind's own startup banner (device/seat enumeration)
# inherits whatever console fd runsvdir started with and prints straight
# to the physical screen, regardless of which VT is actually focused
install -Dm755 "$FLUX_RECIPE_DIR/files/elogind/log/run" "$DESTDIR/etc/sv/elogind/log/run"

%post-install
# physical power-button presses should go through the desktop's own handling, not an immediate elogind poweroff
sed -i 's/^#\?HandlePowerKey=.*/HandlePowerKey=ignore/' /etc/elogind/logind.conf
sv up /etc/sv/elogind 2>/dev/null || true
