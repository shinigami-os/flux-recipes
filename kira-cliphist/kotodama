[meta]
name = kira-cliphist
version = 0.7.0
description = "Clipboard history manager for Wayland - not in Alpine's index, Sleex's own clipboard history (Super+V) depends on it"
license = MIT
size = 5

[source]
# was pinned to #master (a branch, not a tag) - that commit aged out and stopped
# matching the pinned sha256 the moment master moved on, aborting every fresh
# build. real version tags exist upstream, pin to one of those instead
url = git+https://github.com/sentriz/cliphist#v0.7.0
sha256 = efb61cb5b5a28d896c05a24ac83b9c39c96575f2

[deps]
build = go git
runtime = wl-clipboard xdg-utils

[build]
cflags =

%pre-build

%build
export CGO_ENABLED=0
go build -o cliphist .

%post-build

%install
install -Dm755 cliphist "$DESTDIR/usr/bin/cliphist"
