[meta]
name = kira-nextpnr-gowin
version = 0.11.1.3
description = "nextpnr place-and-route for Gowin FPGAs (nextpnr-himbaechel, gowin micro-architecture)"
license = ISC
size = 1

[source]
url = git+https://github.com/YosysHQ/nextpnr#nextpnr-0.11.1
sha256 = 62e659ed6748e9f60b2a4aa25dd4fe79a9605881

[deps]
build = gcc g++ libc-dev cmake ninja make pkgconf python3 python3-dev boost-dev eigen-dev libunwind-dev kira-apicula
runtime = python3 libunwind boost-libs boost-program_options boost-iostreams boost-thread boost-filesystem libstdc++ kira-apicula

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
cmake -S . -B build -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DARCH=himbaechel \
    -DHIMBAECHEL_UARCH=gowin \
    -DBUILD_GUI=OFF \
    -DBUILD_TESTS=OFF \
    -DUSE_IPO=OFF \
    -DUSE_OPENMP=ON
cmake --build build -j12

%post-build

%install
DESTDIR="$DESTDIR" cmake --install build
