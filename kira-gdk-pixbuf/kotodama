[meta]
name = kira-gdk-pixbuf
version = 2.44.7.2
description = "gdk-pixbuf rebuilt with traditional linked png/jpeg/gif/tiff loaders instead of glycin, plus the shared-mime-info database Alpine's package never actually generates"
license = LGPL-2.1-or-later
size = 5

[source]
url = https://download.gnome.org/sources/gdk-pixbuf/2.44/gdk-pixbuf-2.44.7.tar.xz
sha256 = 172f80e3626ec31520a970400f1a3694e04718f6c2cd2885f75250fb5a6995a4

[deps]
build = meson samurai pkgconf glib-dev libpng-dev libjpeg-turbo-dev giflib-dev tiff-dev
# gdk-pixbuf must already be on the system before this package's %post-install
# overwrites its files - it's a real runtime dep here, not just a build-time header source
runtime = glib libpng libjpeg-turbo giflib tiff shared-mime-info gdk-pixbuf

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
# The actual root cause of "Couldn't recognize the image file format" (every
# format, every loader backend, confirmed with a standalone C program) is
# gdk-pixbuf's gio_sniffing option: instead of its own byte-signature check,
# it asks GIO's g_content_type_guess() to identify the file, which reads
# shared-mime-info's compiled mime.cache - and that file never gets built
# because shared-mime-info's Alpine package relies on a post-install trigger
# (update-mime-database) to generate it, and flux doesn't run Alpine triggers
# (same gap as install_if). With no mime.cache, g_content_type_guess() always
# falls back to application/octet-stream, which matches nothing.
#
# Fixed below by running update-mime-database directly. Built with the
# traditional loaders instead of Alpine's glycin-only config anyway, since
# glycin's extra sandboxing (bubblewrap + a spawned decoder subprocess per
# image) is more moving parts than this needs and isn't Alpine's default
# elsewhere - not required for the fix, just less to go wrong.
meson setup builddir --prefix=/usr --libdir=/usr/lib \
    -Dpng=enabled -Djpeg=enabled -Dgif=enabled -Dtiff=enabled \
    -Dglycin=disabled -Dothers=disabled -Dandroid=disabled \
    -Dbuiltin_loaders=all \
    -Dintrospection=disabled -Ddocumentation=false -Dman=false \
    -Dtests=false -Dinstalled_tests=false
meson compile -C builddir

%post-build

%install
DESTDIR="$DESTDIR" meson install -C builddir

%post-install
# deliberately overwrites files owned by the plain "gdk-pixbuf" Alpine package
# at the exact same paths - flux has no provides/override mechanism for
# Alpine-transitive dependencies (gtk+3.0 etc pull in bare gdk-pixbuf no
# matter what), so this is the only way to make the fix apply system-wide.
# known fragile: a future update or fresh install of gdk-pixbuf will silently
# revert this until kira-gdk-pixbuf happens to reinstall after it.

# the real fix: shared-mime-info's mime.cache is never generated because its
# Alpine package expects a post-install trigger flux never runs
update-mime-database /usr/share/mime 2>/dev/null || true

# -Dbuiltin_loaders=all bakes every format directly into the library, so
# nothing here actually depends on loaders.cache - regenerated anyway for
# any legacy consumer (like XPM's gdk_pixbuf_new_from_xpm_data) that expects it
gdk-pixbuf-query-loaders --update-cache 2>/dev/null || true
