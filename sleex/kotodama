[meta]
name = sleex
version = 1.36.4
description = "AxOS Sleex desktop environment (Hyprland + quickshell shell)"
license = GPL-3.0-only
size = 20

[source]
url = git+https://github.com/AxOS-project/Sleex#main
sha256 = b8d5373e3f40b52d2522819bfe49d2f64b31b2ab

[deps]
build = gcc cmake ninja pkgconf qt6-base qt6-declarative qt6-connectivity qt6-5compat qt6-multimedia sleex-ui-kit quickshell rsync
runtime = hyprland quickshell qt6-base qt6-declarative qt6-wayland qt6-connectivity qt6-5compat qt6-multimedia qt6-svg sleex-ui-kit jq sqlite python3 bc
optional = matugen hyprlock hypridle wl-clipboard fuzzel foot howdy ffmpeg imagemagick kdialog

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build
# Sleex's own lockscreen/pam/password_face.conf (loaded when Settings >
# Security > Face Auth is on) references /lib/security/pam_howdy.so, which
# doesn't exist anywhere - upstream howdy has never shipped a compiled PAM
# module by that name, only the pam-python bridge (pam_python.so
# invoking a script). Point it at the real module + script Kira installs.
sed -i 's#/lib/security/pam_howdy.so#/usr/lib/security/pam_python.so /usr/lib/security/howdy/pam.py#' \
    src/share/sleex/modules/lockscreen/pam/password_face.conf

# upstream's own wayland-sessions/sleex.desktop says "Exec=sleex" (the raw
# launcher, no env setup at all). kira-desktop-sleex ships a proper wrapper
# at /usr/bin/kira-start-sleex (XDG_DATA_DIRS with the flatpak export path,
# dbus-run-session, XDG_RUNTIME_DIR setup...) but nothing ever pointed the
# actual session entry at it - regreet reads this exact file directly, so
# every real login silently ran the bare upstream binary instead, with none
# of that setup. This is why flatpak apps never showed in the launcher and
# why Hyprland's own process had neither XDG_DATA_DIRS nor
# DBUS_SESSION_BUS_ADDRESS set: kira-start-sleex, which sets both, was
# never actually being invoked by a real graphical login.
sed -i 's#^Exec=sleex$#Exec=/usr/bin/kira-start-sleex#' \
    src/share/wayland-sessions/sleex.desktop

%build
cd src/share/sleex
cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DDISTRIBUTOR="Kira Linux" \
    -DINSTALL_QMLDIR=usr/qml
cmake --build build

%post-build

%install
# executables
install -dm755 "$DESTDIR/usr/bin"
cp -a src/bin/. "$DESTDIR/usr/bin/"
chmod 755 "$DESTDIR/usr/bin/"*
# system config (sleex hyprland lua config + xdg mimeapps)
install -dm755 "$DESTDIR/etc"
cp -a src/etc/. "$DESTDIR/etc/"
# compiled quickshell plugin (CMakeLists sets prefix "/")
( cd src/share/sleex && DESTDIR="$DESTDIR" cmake --install build )
# QML shell runtime tree
install -dm755 "$DESTDIR/usr/share/sleex"
rsync -a \
    --exclude 'build/' \
    --exclude 'CMakeLists.txt' \
    --exclude 'plugins/' \
    --exclude '.qmlls.ini' \
    --exclude '.qt/' \
    src/share/sleex/ "$DESTDIR/usr/share/sleex/"
# wayland session entry
install -Dm644 src/share/wayland-sessions/sleex.desktop \
    "$DESTDIR/usr/share/wayland-sessions/sleex.desktop"
