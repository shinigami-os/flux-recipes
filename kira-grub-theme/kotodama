[meta]
name = kira-grub-theme
version =
description = "Kira Linux's GRUB theme, drawn like The Line: black, one hairline, the accent marker, the entries as rows"
license = GPL-3.0-or-later
size = 1

[source]
# rolling like The Line: floats on main's latest commit, flux records the built one
url = git+https://github.com/shinigami-os/kira-grub-theme#main
sha256 =

[deps]
build =
runtime = grub

[build]
cflags =

%pre-build

%build

%post-build

%install
install -d "$DESTDIR/boot/grub/themes/kira"
cp kira/* "$DESTDIR/boot/grub/themes/kira/"

%post-install
