[meta]
name = kira-greetd
version = 1.19
description = "Graphical login greeter: greetd + cage + a custom eww greeter (Kira Login), with the runit service Alpine's own package never ships"
license = MIT
size = 1

[source]
url = git+https://github.com/shinigami-os/kira-desktop#v26.09-16
sha256 = 68ac90d15dce336be39455f3f2ce845d3eb6b2ec

[deps]
build =
runtime = greetd cage dbus-x11 kira-eww python3 jq font-raleway font-jetbrains-mono-nerd

[build]
cflags =

%pre-build

%build

%post-build

%install
install -dm755 "$DESTDIR/etc/greetd" "$DESTDIR/etc/sv/greetd" "$DESTDIR/etc/sv/greetd/log" "$DESTDIR/etc/pam.d"
install -m644 "$FLUX_RECIPE_DIR/files/config.toml" "$DESTDIR/etc/greetd/config.toml"
# Alpine's own greetd package ships a PAM config that includes base-auth/base-account/base-password/
# base-session, none of which exist anywhere on Kira - replace it with the same pam_unix.so +
# pam_elogind.so stack /etc/pam.d/login already uses successfully
install -m644 "$FLUX_RECIPE_DIR/files/pam-greetd" "$DESTDIR/etc/pam.d/greetd"
# pam_elogind.so doesn't reliably create /run/user/$UID when greetd (rather than
# a normal getty/login) is the one opening the session, so every desktop session
# greetd launches was failing at its own "mkdir /run/user/$UID" (root-owned 0755
# parent, no write permission for the target user) - do it ourselves via pam_exec
install -m755 "$FLUX_RECIPE_DIR/files/xdg-runtime-dir.sh" "$DESTDIR/etc/greetd/xdg-runtime-dir.sh"
# resolves the keyboard layout from /etc/keymaps and exports it before exec'ing
# cage - has to happen here, not in cage's own client, since cage (the Wayland
# compositor) is what resolves keycodes to keysyms, and it does that once at
# its own startup, before its client (the eww greeter) ever runs
install -m755 "$FLUX_RECIPE_DIR/files/start-greeter.sh" "$DESTDIR/etc/greetd/start-greeter.sh"
install -m755 "$FLUX_RECIPE_DIR/files/greetd/run" "$DESTDIR/etc/sv/greetd/run"
install -m755 "$FLUX_RECIPE_DIR/files/greetd/log/run" "$DESTDIR/etc/sv/greetd/log/run"

# Kira Login: the custom eww greeter from kira-desktop, replacing regreet so the
# design handoff's exact floating layout is achievable (GTK CSS on regreet's own
# fixed widget tree can't move things around, only recolor them)
install -dm755 "$DESTDIR/etc/greetd/kira-login"
cp -a "login/." "$DESTDIR/etc/greetd/kira-login/"

%post-install
# greetd now owns tty1 - the old auto-login-as-root getty (kira-login) must not race it for
# the same VT, and Hyprland itself refuses to launch as root anyway
touch /etc/sv/getty-tty1/down
sv down /etc/sv/getty-tty1 2>/dev/null || true

# Alpine's greetd .pre-install creates the "greetd" system user with home /var/lib/greetd, but
# never actually creates or owns that directory - eww needs it writable for its own cache dir,
# and without it the greeter silently exits before ever creating a session
mkdir -p /var/lib/greetd
chown greetd:greetd /var/lib/greetd
chmod 750 /var/lib/greetd

rm -f /etc/sv/greetd/down
sv up /etc/sv/greetd 2>/dev/null || true
