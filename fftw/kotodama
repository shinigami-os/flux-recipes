[meta]
name = fftw
version = 3.3.10
description = "Fast Fourier Transform library, needed by cava"
license = GPL-2.0-or-later
size = 4

[source]
url = https://fftw.org/pub/fftw/fftw-3.3.10.tar.gz
sha256 = 56c932549852cddcfafdab3820b0200c7742675be92179e59e6215b340e26467

[deps]
build = gcc make
runtime =

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
export CFLAGS="-O2 -pipe -march=x86-64-v2"
./configure --prefix=/usr --enable-shared --disable-static --enable-threads
make

%post-build

%install
make DESTDIR="$DESTDIR" install
