[meta]
name = nouveau-firmware
version = 20260810
description = "NVIDIA GSP firmware for the in-kernel nouveau driver (Maxwell through current)"
license = NVIDIA-driver-EULA
size = 300

[source]
url = git+https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git#20260810
sha256 = 2135b2f7714a3a514c989b9728f51f36144cab6f

[deps]
build = git
runtime =

[build]
cflags =

%pre-build

%build

%post-build

%install
install -dm755 "$DESTDIR/lib/firmware/nvidia"
cp -a nvidia/. "$DESTDIR/lib/firmware/nvidia/"
install -dm755 "$DESTDIR/usr/share/licenses/nouveau-firmware"
install -m644 LICENSES/LICENCE.nvidia "$DESTDIR/usr/share/licenses/nouveau-firmware/"

%post-install
echo "[nouveau-firmware] GSP firmware installed for the nouveau driver."
echo "  modprobe -r nouveau && modprobe nouveau"
echo "Or reboot."
