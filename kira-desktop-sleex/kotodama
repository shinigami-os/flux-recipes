[meta]
name = kira-desktop-sleex
version = 1.0.20
description = "Sleex desktop environment meta-package (Hyprland + quickshell)"
license = MIT
size = 1

[source]

[deps]
build =
runtime = icu-data-full mesa mesa-egl mesa-gl mesa-gles mesa-dri-gallium xwayland kira-hyprland kira-xdg-desktop-portal-hyprland xdg-desktop-portal-gtk kira-quickshell qt6-qtbase qt6-qtdeclarative qt6-qtwayland qt6-qtsvg kira-matugen kira-hyprlock kira-hypridle wlogout wl-clipboard fuzzel foot pcmanfm-qt lxqt-archiver kvantum kvantum-qt5 kvantum-qt6 kvantum-themes grim slurp playerctl brightnessctl pamixer pavucontrol pipewire pipewire-pulse wireplumber iw network-manager-applet python3 jq kira-greetd xdg-user-dirs kira-bibata-cursor-theme kira-featherpad kira-flatpak dbus kira-upower networkmanager bluez kira-desktop-fonts kira-gdk-pixbuf kira-sleex kira-desktop-sleex-config

[build]
cflags =

%pre-build

%build

%post-build

%install
install -dm755 "$DESTDIR/usr/share/kira-desktop"
cat > "$DESTDIR/usr/share/kira-desktop/sleex.desktop-env" << 'EOF'
name = sleex
package = kira-desktop-sleex
launch = /usr/bin/kira-start-sleex
description = Sleex desktop: Hyprland compositor with a quickshell bar and Material You theming
EOF
install -Dm755 "$FLUX_RECIPE_DIR/files/kira-start-sleex" "$DESTDIR/usr/bin/kira-start-sleex"

# Sleex's own Config.qml hardcodes this exact path as wallpaperPath's default
# (modules/common/Config.qml) - upstream has renamed this file before, so if
# the wallpaper goes blank again after a kira-sleex bump, check this filename
# against Config.qml's current default first
install -Dm644 "$FLUX_RECIPE_DIR/files/default.png" "$DESTDIR/usr/share/backgrounds/sleex/SleexOne.png"

# same story for Config.qml's dashboard.avatarPath default - upstream hardcodes
# this exact path but no package (Kira's or upstream's own PKGBUILD) has ever
# shipped a file there, so the dashboard/settings avatar was just blank
install -Dm644 "$FLUX_RECIPE_DIR/files/avatar-default.png" "$DESTDIR/usr/share/pixmaps/sleex/1024px/white.png"

%post-install
# flux doesn't run Alpine's package triggers, so the .gschema.xml files
# shipped by GTK/GNOME-schema packages (pulled in transitively by
# xdg-desktop-portal-gtk and friends) never get compiled into
# gschemas.compiled - every GSettings lookup then aborts the process
# outright (SIGABRT, "No GSettings schemas are installed on the
# system"), which is why xdg-desktop-portal-gtk crash-looped on every
# single portal call and quickshell's own session died shortly after
glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true

echo "[kira-desktop-sleex] Sleex installed. Set it active with:"
echo "  echo sleex > ~/.config/kira-desktop/active-de"
