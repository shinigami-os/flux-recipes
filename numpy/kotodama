[meta]
name = numpy
version = 2.5.1
description = "Python array/numerical library, needed by dlib (howdy face-auth chain)"
license = BSD-3-Clause
size = 30

[source]
url = https://github.com/numpy/numpy/releases/download/v2.5.1/numpy-2.5.1.tar.gz
sha256 = a48a113e6afea91f5608793bafa7ef2ad481fefbda87ec5069f483de61cb9fa3

[deps]
build = gcc make meson ninja pkgconf python3 openblas
runtime = openblas python3

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build
# numpy 2.x builds via meson+meson-python (PEP517), not the old
# numpy.distutils/site.cfg mechanism - meson-python and cython aren't
# packaged as their own flux recipes yet, so pull them from PyPI as
# build-time-only tools into this build dir, same pattern elogind already
# uses for jinja2. System meson/ninja (already packaged) are what actually
# get invoked; meson-python is just the thin PEP517 wrapper around them
python3 -m ensurepip --default-pip >/dev/null 2>&1 || true
python3 -m pip install --quiet build installer meson-python cython

%build
# numpy 2.4+ defaults to SSE4.1/SSE4.2 dispatch and crashes with "Illegal
# Instruction" on older CPUs (numpy issue #30492) - disable CPU-specific
# dispatch for portability across whatever hardware Kira ends up on.
# openblas.pc (generated by the openblas recipe) lets meson's
# dependway('openblas') resolve automatically via pkg-config, no
# site.cfg needed (that's the old distutils-era mechanism, unused by the
# meson build).
export CFLAGS="-O2 -pipe -march=x86-64-v2 -O3"
python3 -m build --wheel --no-isolation \
    -Csetup-args=-Dcpu-baseline=none \
    -Csetup-args=-Dcpu-dispatch=none \
    -Csetup-args=-Dblas=openblas \
    -Csetup-args=-Dlapack=openblas

%post-build

%install
python3 -m installer --destdir="$DESTDIR" dist/*.whl
