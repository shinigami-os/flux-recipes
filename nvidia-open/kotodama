[meta]
name = nvidia-open
version = 610.57.04
description = "NVIDIA open-source GPU kernel modules (nvidia, nvidia-drm, nvidia-modeset, nvidia-uvm)"
license = MIT-and-GPL-2.0-only
size = 40

[source]
url = git+https://github.com/NVIDIA/open-gpu-kernel-modules#610.57.04
sha256 = e4a5faa2567f28c8eabe0ebb6422b6d0abcf37eb

[deps]
build = clang libelf perl bc
runtime = nvidia-gsp-firmware

[build]
cflags =

%pre-build
# modules_prepare never produces a real Module.symvers, so one is bundled below
git clone --depth 1 --branch v7.1.3-shinigami-26.08-4 https://github.com/shinigami-os/shinigami.git kernel-src
cp "$FLUX_RECIPE_DIR/files/shinigami.config" kernel-src/.config
make -C kernel-src LLVM=1 LOCALVERSION= CC="clang --target=x86_64-linux-musl" HOSTCC="clang --target=x86_64-linux-musl" HOSTLD=ld.lld LD=ld.lld AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy olddefconfig
make -C kernel-src LLVM=1 LOCALVERSION= CC="clang --target=x86_64-linux-musl" HOSTCC="clang --target=x86_64-linux-musl" HOSTLD=ld.lld LD=ld.lld AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy modules_prepare -j$(nproc)
cp "$FLUX_RECIPE_DIR/files/Module.symvers" kernel-src/Module.symvers

%build
# LOCALVERSION= avoids a stray "+"; CC check false-positives on triple spelling only
IGNORE_CC_MISMATCH=1 make modules -j$(nproc) \
    SYSSRC="$PWD/kernel-src" \
    LOCALVERSION= \
    CC="clang --target=x86_64-linux-musl" \
    HOSTCC="clang --target=x86_64-linux-musl" \
    HOSTLD=ld.lld \
    LD=ld.lld \
    AR=llvm-ar \
    NM=llvm-nm \
    OBJCOPY=llvm-objcopy

%post-build

%install
KERNELRELEASE=$(cd kernel-src && make -s kernelrelease LLVM=1 LOCALVERSION= CC="clang --target=x86_64-linux-musl")
install -dm755 "$DESTDIR/lib/modules/$KERNELRELEASE/extra"
find kernel-open -name '*.ko' -exec install -Dm644 {} "$DESTDIR/lib/modules/$KERNELRELEASE/extra/" \;
install -dm755 "$DESTDIR/etc/modules-load.d"
printf 'nvidia\nnvidia_drm\nnvidia_modeset\nnvidia_uvm\n' > "$DESTDIR/etc/modules-load.d/nvidia.conf"
install -dm755 "$DESTDIR/etc/modprobe.d"
echo 'options nvidia-drm modeset=1' > "$DESTDIR/etc/modprobe.d/nvidia-drm-modeset.conf"

%post-install
depmod -a
echo "[nvidia-open] Requires ibt=off in the kernel cmdline (GRUB_CMDLINE_LINUX) or nvidia_drm init crashes on IBT."
echo "[nvidia-open] Kernel modules installed for KERNELRELEASE above."
echo "files/Module.symvers and files/shinigami.config are both snapshots"
echo "from a local build of the exact kernel commit above - re-capture both"
echo "after bumping the git branch tag in %pre-build for a new kernel version."
echo "Reboot for the modules to load, or: modprobe nvidia_drm"
