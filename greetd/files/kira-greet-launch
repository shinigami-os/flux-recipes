#!/bin/sh
# greetd launches the [default_session] (the greeter itself) directly, with
# no PAM login session opened for it - so unlike a real logged-in session,
# nothing ever sets XDG_RUNTIME_DIR here. The directory itself is prepared
# by etc/sv/greetd/run (as root, before privileges are dropped to us) since
# we can't create it under root-owned /run/user ourselves.
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
# wlroots picks the keyboard layout up from XKB_DEFAULT_*, and defaults to us
# when they're unset - so the greeter came up qwerty on an azerty machine even
# though the console and the session configs are both fr. Follow the keymap the
# installer wrote, which is the same source of truth the console uses. (Console
# keymap and XKB layout names agree for fr/de/es/etc; override here if they
# ever don't.)
if [ -r /etc/vconsole.conf ]; then
    . /etc/vconsole.conf 2>/dev/null || true
fi
export XKB_DEFAULT_LAYOUT="${KEYMAP:-us}"
# cage inherits tty1 as its controlling terminal from greetd, so its own
# stderr prints straight over the physical screen instead of through
# svlogd - redirect it to a plain file instead so crashes can be inspected
exec >>/home/greetd/greeter.log 2>&1
# regreet talks to accounts-daemon over the system bus at startup and
# panics outright if the socket isn't there yet, same race kira-start-sleex
# already waits out for pipewire/dbus
i=0
while [ ! -S /var/run/dbus/system_bus_socket ] && [ $i -lt 15 ]; do
    sleep 1
    i=$((i + 1))
done

# regreet's own log file defaults to /var/log/regreet/log, which greetd
# (an unprivileged user) can't create - point it at its own home instead
#
# cage defaults to "-m extend", which treats every connected output as one
# combined canvas and stretches the single regreet window across all of
# them - with two real separate monitors (not a bezel-matched video wall)
# that reads as garbled/split-in-half. "-m last" confines it to a single
# output instead.
exec cage -s -m last -- regreet -l /home/greetd/regreet.log
