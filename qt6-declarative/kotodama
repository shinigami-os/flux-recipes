[meta]
name = qt6-declarative
version = 6.11.1
description = "Qt6 Declarative (QML and Qt Quick) framework"
license = GPL-3.0-only OR LGPL-3.0-only
size = 90

[source]
url = https://download.qt.io/archive/qt/6.11/6.11.1/submodules/qtdeclarative-everywhere-src-6.11.1.tar.xz
sha256 = 52e670f670b0304f534b24f98c47ceb8a41bb710464414ebc9527ec71cc86aa4

[deps]
build = gcc cmake ninja pkgconf python3 qt6-base qt6-shadertools libglvnd mesa
runtime = qt6-base libglvnd mesa

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build
# ios_base_library_init is only emitted as a linker alias when libstdc++ detects
# GNU symbol versioning at its own build time; Kira's libstdc++ never created it,
# but Qt's <iostream> usage references the name directly. Provide it ourselves,
# scoped to CMAKE_SHARED_LINKER_FLAGS only so CMake's C-only sanity check still passes.
cat > ios_base_library_init_shim.cpp << 'EOF'
#include <ios>
namespace std {
void ios_base_library_init() {
    static ios_base::Init init;
}
}
EOF
g++ -c -O2 -fPIC -o ios_base_library_init_shim.o ios_base_library_init_shim.cpp

%build
cmake -S . -B build -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_CXX_FLAGS=-U_GLIBCXX_ASSERTIONS \
    -DCMAKE_SHARED_LINKER_FLAGS="$(pwd)/ios_base_library_init_shim.o" \
    -DQT_BUILD_TESTS=OFF \
    -DQT_BUILD_EXAMPLES=OFF
cmake --build build

%post-build

%install
DESTDIR="$DESTDIR" cmake --install build
