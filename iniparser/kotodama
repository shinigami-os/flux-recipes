[meta]
name = iniparser
version = 4.2.6
description = "Simple C library for parsing ini files, needed by cava"
license = MIT
size = 2

[source]
url = git+https://github.com/ndevilla/iniparser#v4.2.6
sha256 = 4bef811283e0ec1658c60e09950bd5a1ddc92e4b

[deps]
build = gcc cmake ninja
runtime =

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_TESTING=OFF
cmake --build build

%post-build

%install
DESTDIR="$DESTDIR" cmake --install build
