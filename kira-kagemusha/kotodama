[meta]
name = kira-kagemusha
version =
description = "A decoy screen: every app sees the resolution you ask for (2K, 4K, any) and the real panel shows it scaled down, plus the runit service that keeps the evdi virtual display device present"
license =
size = 1

[source]
# rolling like the owner's other repos: floats on main's latest commit, flux records the built one
url = git+https://github.com/shinigami-os/kagemusha#main
sha256 =

[deps]
build = gcc libc-dev make kira-libevdi
runtime = kira-libevdi

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
make build/kage build/kage-edid daemon CFLAGS="-std=c11 -D_GNU_SOURCE -O2 -pipe -march=x86-64-v2 -Wall -Wextra"

%post-build

%install
install -Dm755 build/kage "$DESTDIR/usr/bin/kage"
install -Dm755 build/kagemushad "$DESTDIR/usr/bin/kagemushad"
install -Dm755 build/kage-edid "$DESTDIR/usr/bin/kage-edid"
install -dm755 "$DESTDIR/etc/sv/kagemusha-evdi"
install -m755 "$FLUX_RECIPE_DIR/files/kagemusha-evdi/run" "$DESTDIR/etc/sv/kagemusha-evdi/run"

%post-install
# the module ships with the Shinigami kernels built after the evdi patch; an older kernel just keeps the service retrying
modinfo evdi >/dev/null 2>&1 || echo "kagemusha: the running kernel has no evdi module (flux sys upgrade kernel, then reboot)"
sv up /etc/sv/kagemusha-evdi 2>/dev/null || true
