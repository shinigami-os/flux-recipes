[meta]
name = nvidia-gsp-firmware
version = 610.57.04
description = "NVIDIA GSP firmware blobs (Turing/Ampere/Ada), required by nvidia-open"
license = NVIDIA-driver-EULA
size = 115

[source]
url = https://download.nvidia.com/XFree86/Linux-x86_64/610.57.04/NVIDIA-Linux-x86_64-610.57.04.run
sha256 = b2e935c66b83bb00c0c857bc8e0ee0fd52de9286b40c9cc1eec29a7ce7eb116d

[deps]
build =
runtime =

[build]
cflags =

%pre-build
sh NVIDIA-Linux-x86_64-610.57.04.run --extract-only

%build

%post-build

%install
install -dm755 "$DESTDIR/lib/firmware/nvidia/610.57.04"
# gsp_ga10x.bin covers Ampere and Ada Lovelace (including this laptop's
# AD107M) - NVIDIA has not shipped a separate ad10x blob as of this release.
# gsp_tu10x.bin is included too for Turing-generation hardware.
install -m644 NVIDIA-Linux-x86_64-610.57.04/firmware/gsp_ga10x.bin "$DESTDIR/lib/firmware/nvidia/610.57.04/"
install -m644 NVIDIA-Linux-x86_64-610.57.04/firmware/gsp_tu10x.bin "$DESTDIR/lib/firmware/nvidia/610.57.04/"
install -dm755 "$DESTDIR/usr/share/licenses/nvidia-gsp-firmware"
install -m644 NVIDIA-Linux-x86_64-610.57.04/LICENSE "$DESTDIR/usr/share/licenses/nvidia-gsp-firmware/"

%post-install
echo "[nvidia-gsp-firmware] GSP firmware installed for driver 610.57.04."
echo "Must stay version-matched with the nvidia-open kernel modules."
