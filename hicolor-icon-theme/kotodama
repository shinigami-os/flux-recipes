[meta]
name = hicolor-icon-theme
version = 0.17.1
description = "Fallback icon theme required by the freedesktop.org icon theme spec"
license = GPL-2.0-or-later
size = 1

[source]
# icon-theme.freedesktop.org's own release server is a small, self-hosted box
# that's repeatedly gone unreachable on port 443 and stalled ISO builds. No
# other mirror hosts the release tarball itself under a usable filename
# (flux derives both the local destination path and whether to run tar on it
# from the URL's own basename), so build straight from the tag on
# gitlab.freedesktop.org instead - solid, unrelated infrastructure, and
# self-contained once cloned since it doesn't depend on any tarball mirror
# surviving. The git checkout has no generated configure script, hence
# autoreconf below.
url = git+https://gitlab.freedesktop.org/xdg/default-icon-theme#0.17
sha256 = f522d9d0bb08c395ccc1a140bf693a9e239ef61e

[deps]
build = make autoconf automake
runtime =

[build]
cflags =

%pre-build
autoreconf -fi

%build
./configure --prefix=/usr

%post-build

%install
make DESTDIR=$DESTDIR install
