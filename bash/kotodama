[meta]
name = bash
version = 5.3.1
description = "GNU Bourne-Again Shell"
license = GPL-3.0-or-later
size = 3

[source]
url = https://mirror.ibcp.fr/pub/gnu/bash/bash-5.3.tar.gz
sha256 = 0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba

[deps]
build = gcc make
runtime = ncurses

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
./configure \
    --prefix=/usr \
    --bindir=/usr/bin \
    --without-bash-malloc \
    --with-curses \
    --disable-nls \
    ${FLUX_CROSS_HOST:+--host=$FLUX_CROSS_HOST} \
    ${CC:+CC=$CC}
make

%post-build

%install
make DESTDIR="$DESTDIR" install

%post-install
# see zsh's kotodama for why this matters: kira-base only ever seeds
# /etc/shells with /bin/sh, so anything checking it (notably pkexec/polkit)
# rejects any real shell outright even though it works fine otherwise
grep -qx /usr/bin/bash /etc/shells || echo /usr/bin/bash >> /etc/shells
