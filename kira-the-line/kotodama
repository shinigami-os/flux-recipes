[meta]
name = kira-the-line
version =
description = "The Line, Kira Linux's own Quickshell desktop shell for Hyprland, with its session, settings app and cursor theme"
license = GPL-3.0-or-later
size = 8

[source]
# rolling like Kira itself: floats on main's latest commit, flux records the built one
url = git+https://github.com/shinigami-os/the-line#main
sha256 =

[deps]
build = python3 py3-pillow coreutils
runtime = kira-the-line-ui kira-greetd kira-xdg-desktop-portal-hyprland xdg-desktop-portal-gtk xwayland mesa mesa-egl mesa-gl mesa-gles mesa-dri-gallium mesa-vulkan-intel mesa-vulkan-nouveau mesa-vulkan-ati kira-hyprland kira-quickshell kira-hyprsunset kira-hypridle kira-hyprlock kira-cliphist kira-cava kira-matugen kira-qt6ct kira-upower kira-ttf-ibm-plex-mono dbus pipewire pipewire-pulse wireplumber networkmanager networkmanager-cli bluez polkit-elogind grim slurp wl-clipboard foot python3 py3-pillow jq brightnessctl playerctl qalc mpv libnotify kvantum adw-gtk3 font-raleway qt6-qtbase qt6-qtdeclarative qt6-qtwayland qt6-qtmultimedia qt6-qtsvg qt6-qt5compat
optional = kira-hyprpicker flameshot wf-recorder tesseract-ocr tesseract-ocr-data-eng yazi kira-voxel kira-howdy fprintd

[build]
cflags =

%pre-build

%build

%post-build

%install
DESTDIR="$DESTDIR" ./install.sh

%post-install
gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
update-desktop-database -q /usr/share/applications 2>/dev/null || true
