[meta]
name = opencv
version = 5.0.0
description = "Computer vision library (core/imgproc/imgcodecs/videoio + Python bindings), needed by howdy"
license = Apache-2.0
size = 80

[source]
url = git+https://github.com/opencv/opencv#5.0.0
sha256 = 40738fb16ceddb5fb3fea747585f7ce6abb0605b

[deps]
build = gcc cmake ninja pkgconf python3 numpy libjpeg-turbo libpng zlib
runtime = python3 numpy libjpeg-turbo libpng zlib

[build]
cflags = -O2 -pipe -march=x86-64-v2

%pre-build

%build
# howdy only actually uses core/imgproc, imgcodecs (imread/imwrite), and videoio
# for camera access - the full OpenCV (contrib, DNN, GUI backends, ffmpeg/
# gstreamer, TBB, Qt, CUDA...) needs dependencies Kira doesn't package at all
# yet, so this is scoped down to exactly what's actually used.
export CXXFLAGS="-O2 -pipe -march=x86-64-v2"
cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_LIST=core,imgproc,imgcodecs,videoio,python3 \
    -DBUILD_opencv_python3=ON \
    -DPYTHON3_EXECUTABLE=/usr/bin/python3 \
    -DPython3_EXECUTABLE=/usr/bin/python3 \
    -DOPENCV_SKIP_PYTHON_LOADER=OFF \
    -DBUILD_TESTS=OFF \
    -DBUILD_PERF_TESTS=OFF \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_DOCS=OFF \
    -DBUILD_opencv_apps=OFF \
    -DWITH_FFMPEG=OFF \
    -DWITH_GSTREAMER=OFF \
    -DWITH_GTK=OFF \
    -DWITH_QT=OFF \
    -DWITH_OPENGL=OFF \
    -DWITH_VULKAN=OFF \
    -DWITH_OPENCL=OFF \
    -DWITH_TBB=OFF \
    -DWITH_IPP=OFF \
    -DWITH_ADE=OFF \
    -DWITH_PROTOBUF=OFF \
    -DWITH_1394=OFF \
    -DWITH_V4L=ON \
    -DBUILD_SHARED_LIBS=ON
cmake --build build

%post-build

%install
DESTDIR="$DESTDIR" cmake --install build
